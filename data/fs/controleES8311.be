    # echerche les coefficients
    def get_coeff(mclk, rate)
        for i: 0..size(self.coeff_div)-1
            if self.coeff_div[i][0] == mclk && self.coeff_div[i][1] == rate
                return i
            end
        end
        return -1
    end
    
    # Configure sample frequency
    def sample_frequency_config(mclk_frequency, sample_frequency)
        var coeff = self.get_coeff(mclk_frequency, sample_frequency)

        if coeff < 0
            self.log(f"Erreur: Configuration impossible du sample rate: {sample_frequency}", LOG_LEVEL_DEBUG_PLUS)
            return false
        end
        
        var selected_coeff = self.coeff_div[coeff]
        
        # Register 0x02
        var regv = self.read_reg(0x02)
        regv &= 0x07
        regv |= (selected_coeff[2] - 1) << 5
        regv |= selected_coeff[3] << 3
        self.write_reg(0x02, regv)
        
        # Register 0x03
        var reg03 = (selected_coeff[6] << 6) | selected_coeff[10]
        self.write_reg(0x03, reg03)
        
        # Register 0x04
        self.write_reg(0x04, selected_coeff[11])
        
        # Register 0x05
        var reg05 = ((selected_coeff[4] - 1) << 4) | (selected_coeff[5] - 1)
        self.write_reg(0x05, reg05)
        
        # Register 0x06
        regv = self.read_reg(0x06)
        regv &= 0xE0
        if selected_coeff[9] < 19
            regv |= (selected_coeff[9] - 1) << 0
        else
            regv |= selected_coeff[9] << 0
        end
        self.write_reg(0x06, regv)
        
        # Register 0x07
        regv = self.read_reg(0x07)
        regv &= 0xC0
        regv |= selected_coeff[7] << 0
        self.write_reg(0x07, regv)
        
        # Register 0x08
        self.write_reg(0x08, selected_coeff[8])
        self.log(f"Fréquence d'échntillonnage configurée: MCLK={mclk_frequency}Hz, Sample Rate={sample_frequency}Hz, Coeff Index={coeff}", LOG_LEVEL_DEBUG_PLUS)
        return true
    end
    
    # Initialise l'ES8311
    def init_codec(sample_freq, mclk_freq)
        import string 

        self.log(f"Initialisation de l'ES8311 codec avec la fréquence d'échantillonnage: {sample_freq}Hz & la fréquence MCLK : {mclk_freq}Hz", LOG_LEVEL_INFO)

        # Reset ES8311
        self.write_reg(0x00, 0x1F)
        tasmota.delay(20)
        self.write_reg(0x00, 0x00)
        self.write_reg(0x00, 0x80)
        
        # Clock configuration
        var reg01 = 0x3F  # Active toutes les horloges
        self.write_reg(0x01, reg01)
        
        # Configure sample frequency
        if !self.sample_frequency_config(mclk_freq, sample_freq)    return false        end
        
        # Configure le format audio (I2S, 16-bit)
        var regv  = self.read_reg(0x00)
        regv &= 0xBF;
        self.write_reg(0x00, regv)
        self.write_reg(0x09, 0x0C)  # SDP In: I2S, 16-bit
        self.write_reg(0x0A, 0x0C)  # SDP Out: I2S, 16-bit
        
        # Active le circuit analogique
        self.write_reg(0x0D, 0x01)  # Active le circuit analogique
        self.write_reg(0x0E, 0x02)  # Active le modulateur PGA and ADC
        self.write_reg(0x12, 0x00)  # Active DAC
        self.write_reg(0x13, 0x10)  # Active la sortie audio
        
        # Configuration ADC/DAC 
        self.write_reg(0x1C, 0x6A)  # Bypass ADC equalizer
        self.write_reg(0x37, 0x08)  # Bypass DAC equalizer
        
        return true
    end
    
    # Réglage du volume (0-100)
    def set_volume(volume)
        if volume < 0
            volume = 0
        elif volume > 100
            volume = 100
        end
        
        var reg32
        if volume == 0
            reg32 = 0
        else
            reg32 = ((volume * 256) / 100) - 1
        end
        
        self.write_reg(0x32, reg32)
        return volume
    end
    
    # Lit le volume
    def get_volume()
        var reg32 = self.read_reg(0x32)

        if reg32 == 0
            return 0
        else
            return ((reg32 * 100) / 256) + 1
        end
    end
    
    # Mute
    def mute(enable)
        var reg31 = self.read_reg(0x31)

        if enable
            reg31 |= 0x60  # Set bits 6 and 5
        else
            reg31 &= ~0x60  # Clear bits 6 and 5
        end
        self.write_reg(0x31, reg31)
    end
    
    # Règle le gain du microphone
    # gain_db: 0x00 to 0x07 (0dB to 42dB)
    def set_mic_gain(gain_db) 
        self.write_reg(0x16, gain_db)
    end
    
    # Configure le microphone
    def config_microphone()
        var reg14 = 0x1A  # Active le analog microphone, max PGA gain
        self.write_reg(0x17, 0xC8)  # Règle le gain ADC
        self.write_reg(0x14, reg14)
        self.set_mic_gain(0x01)  # Règle le gain du microphone à 6dB
    end
    
    # Debugging: Dump des registres
    def register_dump()
        self.log("ES8311 Register Dump:", LOG_LEVEL_INFO)
        for reg: 0..0x49
            var value = self.read_reg(reg)
            self.log(f"REG:{reg:02X}: {value:02X}", LOG_LEVEL_INFO)
        end

    end
end

# Avtivation du driver ES8311
if (drivers["I2S"].find("activation", "OFF") == "ON" && drivers["I2S"]["environnement"]["ES8311"].find("activation", "OFF") == "ON")
    tasmota.log("Activation du driver ES8311", LOG_LEVEL_INFO)

    controleES8311  = ES8311(53)
    controleES8311.set_volume(100)
    controleES8311.set_mic_gain(0x04)  # Set microphone gain to (6*4 =) 24dB

    tasmota.cmd('I2SConfig {"Tx":{"SampleRate":48000,"SlotMask":1,"APLL":0,"SlotConfig":2},"Rx":{"SampleRate":32000,"Channels":1, "Mode":0}}')
end