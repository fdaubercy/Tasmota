# Driver ES8311 Audio Codec
# Fonctionne avec ESP32P4-DEV-KIT
# PA-POWER pin : GPIO 53
var controleES8311

class ES8311 : Driver
    # Variables
    var DEBUG
    var I2C
    var GPIO_PWR_PIN
    
    def init(GPIO_PWR_PIN)
        import gpio

        self.GPIO_PWR_PIN = GPIO_PWR_PIN
        self.I2C = tasmota.wire_scan(0x18)

        if self.I2C == nil
            self.log("ES8311: Echec de l'initialisation I2C !", LOG_LEVEL_DEBUG)
        else
            # var i2s_conf = tasmota.cmd('i2sconfig')
            # var sample_freq = i2s_conf["I2SConfig"]["Tx"]["SampleRate"]
            var sample_freq = 48000
            if self.init_codec(sample_freq, sample_freq * 128)
                self.config_microphone()
                self.log("ES8311: Initialisation réussie", LOG_LEVEL_DEBUG)

                # Configuration du pin d'activation de la sortie I2S
                gpio.pin_mode(self.GPIO_PWR_PIN, gpio.OUTPUT)

                # Active le Driver
                tasmota.add_driver(self)
            else
                self.log("ES8311: Echec de l'initialisation !", LOG_LEVEL_DEBUG)
            end 
        end
    end

    def log(msg, levelDebug)
        import persist
    
        if (self.DEBUG == nil)
            self.DEBUG = drivers["I2S"]["environnement"]["ES8311"].find("debug", "ON")
        end
    
        if (self.DEBUG == "ON")
            log(msg, levelDebug)
        end
    end

    def audio(cmd, idx, payload, raw)
        if cmd == "power"
            self.pa_power(idx ? 1 : 0)
        elif cmd == "rate"
            # ??? seems to work with any rate
            if raw[0] == 0 # tx
                self.sample_frequency_config(idx * 256, idx)
                self.log(f"ES8311: Réglage TX sample rate à {idx}Hz", LOG_LEVEL_DEBUG_PLUS)
            elif raw[0] == 1 # rx
                self.sample_frequency_config(idx * 256, idx)
                self.log(f"ES8311: Réglage RX sample rate à {idx}Hz", LOG_LEVEL_DEBUG_PLUS)
            end
        end
    end

    # PA Power Control
    def pa_power(enable)
        import gpio

        self.log(f"ES8311: Réglage PA GPIO {self.GPIO_PWR_PIN: i} à {(enable)}", LOG_LEVEL_DEBUG_PLUS)
        
        if enable
            gpio.digital_write(self.GPIO_PWR_PIN, 1)
        else
            gpio.digital_write(self.GPIO_PWR_PIN, 0)
        end
    end

    # I2C functions
    def write_reg(reg_addr, data)
        if self.I2C.write(0x18, reg_addr, data, 1)
            return 0
        else
            self.log(f"Write reg {reg_addr:#04x} failed", LOG_LEVEL_DEBUG_PLUS)
            return -1
        end
    end
    
    def read_reg(reg_addr)
        var data = self.I2C.read(0x18, reg_addr, 1)

        self.log(f"Read reg {reg_addr:#04x} = {data:#04x}", LOG_LEVEL_DEBUG_PLUS)

        return data != nil ? data : -1
    end
    
