+# Emet UN datagramme par une socket neuve liee a ipLocale ("" = toutes les interfaces), port
+# source ALEATOIRE (0). Rend true si la pile l'a accepte (pas une preuve de reception).
+def udpFonctions_emet(ipLocale, ipDest, port, message)
+    var u = udp()
+    var ok = u.begin(ipLocale, 0)
+    if (ok)    ok = u.send(ipDest, port, bytes().fromstring(message))    end
+    u.close()
+    return ok ? true : false
+end
